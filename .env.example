# Required for Production (Vercel → Settings → Environment Variables → Production).
# URL must be a full HTTP(S) origin, e.g. https://xxxx.supabase.co (not just the project name).
# After changing these, Redeploy the Vercel project (NEXT_PUBLIC_* are baked in at build time).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: used for Auth redirect URLs (email confirmation, OAuth, password reset).
# Defaults to http://localhost:3000 in local development.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram MTProto (Telethon user client — not Bot API)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Telegram collector analyzer mode: llm | rule_based
TELEGRAM_ANALYZER_MODE=llm

# LLM provider for telegram collector + AI search (SERVER ONLY — never NEXT_PUBLIC_).
# Keys stay in .env.local (gitignored + cursorignored). Rotate if exposed.
# Set exactly one API key:
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Paid OpenRouter models for AI search (tried first). Free models are OFF by default.
# Allowlisted server-side — do not put expensive frontier models here.
OPENROUTER_CHEAP_MODELS=openai/gpt-4.1-nano,google/gemini-2.5-flash-lite,amazon/nova-micro-v1,qwen/qwen-2.5-7b-instruct,inclusionai/ling-2.6-flash

# Opt-in free OpenRouter (slow queues — not recommended for production search).
# OPENROUTER_USE_FREE=1
# OPENROUTER_FREE_MODELS=openrouter/free,google/gemma-4-31b-it:free,openai/gpt-oss-20b:free

# Optional direct provider keys (synced from AI Council for search failover).
# Used only after OpenRouter paid exhaust.
# OPENAI_API_KEY=   → gpt-4.1-nano, gpt-4o-mini
# ANTHROPIC_API_KEY= → Claude Haiku only
# GOOGLE_API_KEY=   → Gemini only (search failover / generative). NOT Maps/Places.
#
# Google Maps / Places enrichment (business address, pin, rating):
# Create a separate key in Google Cloud with Places API enabled
# (Place Text Search + Place Details legacy endpoints).
# GOOGLE_MAPS_API_KEY=
# GOOGLE_PLACES_API_KEY=   → alias; either name works for enrich_places_fill_empty.py

# Production: comma-separated Origins allowed to call /api/search/ai
# (localhost + NEXT_PUBLIC_SITE_URL + VERCEL_URL are always included).
# AI_SEARCH_ALLOWED_ORIGINS=https://krugi.app,https://www.krugi.app

# Optional overrides
# TELEGRAM_LLM_PROVIDER=openrouter
# TELEGRAM_LLM_MODEL=openai/gpt-4o-mini

# Facebook Groups collector PoC (optional — not required for fixture dry-run)
# Never commit real tokens or Facebook cookies/session data.
APIFY_TOKEN=
APIFY_ACTOR_ID=
FACEBOOK_GROUP_URL=
FACEBOOK_DATASET_ID=
# Optional Apify Actor for public Page/profile About enrichment (used with --fetch-profile-pages).
# Example: apify~facebook-pages-scraper
FACEBOOK_PROFILE_ACTOR_ID=
# Optional: JSON cookies for closed groups (Apify secret storage preferred).
# FACEBOOK_COOKIES_JSON=
